 "topics": [
  {
   "name": "Iran og USA",
   "section": "world",
   "lines": [
    {
     "who": "Rezaei",
     "text": "Iran vil give USA et ødelæggende svar, hvis Washington starter en ny krig.",
     "link": "https://www.aa.com.tr/en/us-israel-iran-war/iran-warns-us-of-devastating-response-if-washington-starts-war/4115484",
     "source": "Anadolu",
     "at": "2026-11-07T19:00:05+00:00",
     "added": "2026-11-07T19:12:39+00:00",
     "id": "7e0e2760ba349e61",
     "kind": "s"
    },
    {
     "who": "Erdoğan",
     "text": "I en telefonsamtale med Trump siger han, at spændingerne mellem USA og Iran skal løses diplomatisk.",
     "link": "https://www.aa.com.tr/en/turkiye/erdogan-trump-discuss-bilateral-ties-regional-global-developments/4115444",
     "source": "Anadolu",
     "at": "2026-11-07T17:57:49+00:00",
     "added": "2026-11-07T19:12:39+00:00",
     "id": "4bbde150473b41a2",
     "kind": "s"
    },
    {
     "who": "USA's centralkommando",
     "text": "Marineblokaden har forhindret Iran i at eksportere olie til en værdi af over 25 mia. dollars; en ny styrke skal også begrænse Irans våbentransport over land og via Det Kaspiske Hav.",
     "link": "https://www.al-monitor.com/originals/2026/11/exclusive-expanding-naval-blockade-us-military-looks-restrict-iranian-land",
     "source": "Al-Monitor",
     "at": "2026-11-07T13:46:45+00:00",
     "added": "2026-11-07T14:03:34+00:00",
     "id": "12dce7407b9f8866",
     "kind": "s"
    },
    {
     "who": "Al Jazeera",
     "text": "USA har fortsat angreb på Iran, og skibe i Hormuzstrædet er ramt, mens mæglere forsøger at forhindre eskalering.",
     "link": "https://www.aljazeera.com/news/2026/11/7/qeshm-island-and-hormuz-hit-as-mediators-try-to-prevent-us-iran-escalation?traffic_source=rss",
     "source": "Al Jazeera",
     "at": "2026-11-07T12:22:18+00:00",
     "added": "2026-11-07T13:03:23+00:00",
     "id": "1ed61bc0c753865d",
     "kind": "s"
    },
    {
     "who": "Irans flåde",
     "text": "Et olietankskib er i brand efter at have ramt en mine øst for Hormuzstrædet.",
     "link": "https://t.me/AjaNews/520414",
     "source": "Al Jazeera",
     "at": "2026-11-07T10:08:19+00:00",
     "added": "2026-11-07T11:11:35+00:00",
     "id": "a252de98d9eb15df",
     "kind": "w"
    },
    {
     "who": "Trump",
     "text": "USA har gennemført begrænsede angreb på et luftforsvarsanlæg på Qeshm; det er ikke en krig.",
     "link": "https://www.aljazeera.com/video/newsfeed/2026/11/7/trump-confirms-us-strikes-in-iran-insists-its-not-a?traffic_source=rss",
     "source": "Al Jazeera",
     "at": "2026-11-07T07:05:01+00:00",
     "added": "2026-11-07T11:11:35+00:00",
     "id": "582ce33c70ac1319",
     "kind": "s"
    },
    {
     "who": "Qatars udenrigsministerium",
     "text": "Premierministeren har sagt klart, at Washington og Teheran fortsat arbejder hen imod en aftale.",
     "link": "https://news.google.com/rss/articles/CBMiwwFBVV95cUxNVHlkWU9ORUk3a1hvbDAzWmpwaGRzOUFzSm1lYURCRlNSSlRBM05PLXpsODdQMjVsY3psUE9ZZUpyVzQ1aXhQQ3EwNmt1WDk5ZFhYRWxmU0RqRERNVTFPQktETC1mdFBhaUtjQm54elQ3aEgtdzBaVlZLOTlnaFkxQ3A1XzJieENoTjd5LUVfdFk5UjgwZDU0ZENlLWhTNmYxdk9DNWtfdXJTU2pNc2pWU0t4RUVEVTJfY2FYTG9vX0pHLTA?oc=5",
     "source": "Iraqi News Agency",
     "at": "2026-11-07T05:29:58+00:00",
     "added": "2026-11-07T06:12:32+00:00",
     "id": "a6c375dbf54bc2fa",
     "kind": "s"
    },
    {
     "who": "Irans hærs talsmand",
     "text": "De iranske styrker er stærkere nu end ved krigens begyndelse.",
     "link": "https://english.aawsat.com/node/5338484",
     "source": "Asharq Al-Awsat",
     "at": "2026-11-07T05:06:39+00:00",
     "added": "2026-11-07T06:12:32+00:00",
     "id": "b516fc44ef194908",
     "kind": "s"
    },
    {
     "who": "Qatars premierminister",
     "text": "Mæglingen mellem USA og Iran fortsætter og forhindrer, at situationen løber løbsk.",
     "link": "https://www.al-monitor.com/originals/2026/11/qatar-says-its-mediation-efforts-between-us-and-iran-continue-prevent-escalation",
     "source": "Al-Monitor",
     "at": "2026-11-07T04:46:27+00:00",
     "added": "2026-11-07T05:04:09+00:00",
     "id": "50035e5d1e3b2ca3",
     "kind": "s"
    },
    {
     "who": "Rubio",
     "text": "Intet system som Teherans kan accepteres med et atomvåben.",
     "link": "https://t.me/Alarabiya/169208",
     "source": "Al Jazeera",
     "at": "2026-11-07T04:36:20+00:00",
     "added": "2026-11-07T05:04:09+00:00",
     "id": "d4b4454d333b583e",
     "kind": "w"
    },
    {
     "who": "Trump",
     "text": "USA har gennemført et hurtigt angreb på Iran i går, og han afslører detaljerne.",
     "link": "https://t.me/Alarabiya/169207",
     "source": "Al Jazeera",
     "at": "2026-11-07T04:10:30+00:00",
     "added": "2026-11-07T05:04:09+00:00",
     "id": "b24085949c62bb74",
     "kind": "w"
    },
    {
     "who": "USA",
     "text": "USA udlover 20 mio. dollar for oplysninger om Irans atomprogram.",
     "link": "https://news.google.com/rss/articles/CBMisAFBVV95cUxOMm1YT0llck1GODczcVdKU0R4Rk9HazNaRU42UDBqeFRZUXV6aWpYZV92OElMdS1ZVldzOEFDV1puSEh5MnpkNGFTVkdOY0laUDZ2R2c3SUp4bm1BdklvdV9zbkd2Tlo4Z3Y0b3pYZFhqTDYwb2dEUlVSNTRoREQ4R2dqN1VWellteUx4R1AxQlRpMy10elZHUzh6dXJvTGxVQzJWRW1uQzExVEhtQWhrYw?oc=5",
     "source": "Middle East Eye",
     "at": "2026-11-07T01:54:00+00:00",
     "added": "2026-11-07T19:12:39+00:00",
     "id": "8418bed6b67af3f8",
     "kind": "s"
    },
    {
     "who": "Irans hær",
     "text": "Luftforsvaret har skudt en amerikansk MQ-9-drone ned over Qeshm.",
     "link": "https://www.aa.com.tr/en/middle-east/iran-says-air-defense-downed-us-mq-9-drone-above-qeshm-island/4114837",
     "source": "Anadolu",
     "at": "2026-11-07T00:20:31+00:00",
     "added": "2026-11-07T11:11:35+00:00",
     "id": "b21339b2ba71b08e",
     "kind": "s"
    }
   ]
